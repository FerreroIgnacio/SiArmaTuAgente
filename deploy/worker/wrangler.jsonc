{
  "name": "si-arma-tu-agente",
  "main": "index.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "../../public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*", "/auth/*", "/archivos/*", "/ayuda/variables", "/ayuda/api-meta"]
  },
  "routes": [{ "pattern": "ArmaTuAgente.sisoftwaresolutions.com", "custom_domain": true }],
  "vars": { "ORIGIN": "https://origen-armatuagente.sisoftwaresolutions.com" }
  // secret: ORIGIN_SECRET  (npx wrangler secret put ORIGIN_SECRET)
}
